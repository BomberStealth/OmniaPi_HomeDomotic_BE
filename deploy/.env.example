# Secret condiviso con GitHub per validare le firme HMAC dei webhook.
# Genera un valore lungo e casuale (es: openssl rand -hex 32) e inserisci
# LO STESSO valore sia qui sia nella configurazione webhook su GitHub.
WEBHOOK_SECRET=cambia_questo_secret_lungo_e_casuale

# Branch i cui push attivano il deploy (separati da virgola, senza spazi).
# Default sicuro: solo main + il branch di sviluppo Claude.
ALLOWED_BRANCHES=main,claude/awaiting-instructions-Hajn2

# Porta locale (loopback) su cui ascolta il webhook server. Nginx la proxia.
WEBHOOK_PORT=9000
